# Every variable the project reads. Copy to .env.local (server) or set them in
# your host's dashboard. Values come from YOUR accounts; never commit real ones.
# .env* files are git-ignored (except this one).

# ---------------------------------------------------------------- API server (apps/api, packages/server)

# Supabase project > Settings > Database > Connection string (pooler, "Transaction" mode on Vercel)
DATABASE_URL=

# Supabase project URL: access tokens are verified against its published keys (JWKS)
SUPABASE_URL=
# Only if your project still signs tokens with the legacy shared JWT secret
SUPABASE_JWT_SECRET=
# Not used by the server today (account deletion runs in SQL); keep it out of the app
SUPABASE_SERVICE_ROLE_KEY=

# Public URL of the API, no trailing slash (OAuth redirect URIs are built from it)
API_URL=https://api.example.com
# Deep link the OAuth callback sends the runner back to
APP_RETURN_URL=stride://connections

# Random secrets you generate:  openssl rand -base64 48
APP_SECRET=
# 32 random bytes, base64:  openssl rand -base64 32
TOKEN_ENC_KEY=
# Vercel sends it as "Authorization: Bearer <CRON_SECRET>" to cron routes
CRON_SECRET=

# RevenueCat > Project > Integrations > Webhooks: the Authorization header value you set there
REVENUECAT_WEBHOOK_AUTH=
# RevenueCat > Project > API keys > Secret key (sk_...), server only
REVENUECAT_SECRET_KEY=

# Strava > Settings > My API Application (your own app)
STRAVA_CLIENT_ID=
STRAVA_CLIENT_SECRET=
# Any random string; you pass it when creating the webhook subscription
STRAVA_VERIFY_TOKEN=
# Returned by Strava when you create the push subscription
STRAVA_SUBSCRIPTION_ID=

# Resend > API Keys; EMAIL_FROM must be on a domain you verified in Resend
RESEND_API_KEY=
EMAIL_FROM="Coach <coach@your-domain.example>"

# ---------------------------------------------------------------- mobile app (apps/mobile), public by design

# Without these three the app runs on its on-device demo backend.
EXPO_PUBLIC_API_URL=https://api.example.com
EXPO_PUBLIC_SUPABASE_URL=
# Supabase > Settings > API > anon / publishable key (safe in the app; RLS protects data)
EXPO_PUBLIC_SUPABASE_ANON_KEY=
